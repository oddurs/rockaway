{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "isolatedDeclarations": false,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["astro/client", "node"],
    // A stranger's view of the packages: their published types, from `dist`.
    // The workspace's source condition would check the site against code no
    // consumer can import, so it is switched off here (cairn 0103).
    "customConditions": []
  },
  "include": ["src", "scripts", "test", "astro.config.ts", "vitest.config.ts"]
}
