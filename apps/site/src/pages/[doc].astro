---
/**
 * Every document in the repository's `docs/`, as a page of prose on the grid
 * (cairn 0107, 0143): `docs/concept.md` is `/concept/`.
 */
import { getCollection, render } from 'astro:content';
import Prose from '../layouts/Prose.astro';
import { docFor } from '../lib/docs.ts';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { doc: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description } = docFor(entry.id);
const { Content } = await render(entry);
---

<Prose title={`${title} — rockaway`} description={description}>
  <Content />
</Prose>
