---
/**
 * The page for an address with no page (cairn 0150): a screen, in the shell,
 * like every other, with the map beside it and a way home under it.
 */
import { Attr, Buffer, drawBox, drawText, rect } from '@rockaway/grid';
import { Screen } from '@rockaway/react';
import Prose from '../layouts/Prose.astro';
import { fixed } from '../lib/pages.ts';
import { href } from '../lib/paths.ts';

// As wide as a phone has room for, like the landing page's drawing.
const COLS = 34;
const ROWS = 5;
const screen = Buffer.create({ width: COLS, height: ROWS }).draw((draft) => {
  drawBox(draft, rect(0, 0, COLS, ROWS), { title: '404', titleStyle: { attrs: Attr.bold } });
  drawText(draft, { x: 2, y: 1 }, 'No page at this address.');
  drawText(draft, { x: 2, y: 3 }, 'g h  home     ?  keys', {
    style: { fg: 'fg.muted', attrs: Attr.none },
  });
});
---

<Prose title={fixed.missing.title} description={fixed.missing.description} name="404">
  <h1>Not here</h1>
  <figure aria-label="404: no page at this address.">
    <Screen draw={() => screen} cols={COLS} rows={ROWS} aria-hidden="true" />
  </figure>
  <p>
    There is no page at this address. Go <a href={href('')}>home</a>, or take a page from the map:
    every page of the site is there.
  </p>
</Prose>
