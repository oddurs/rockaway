---
/**
 * The first page (cairn 0103): a Frame from the published `@rockaway/react`,
 * hydrated as an island, to prove the pipeline end to end. The landing page
 * proper is 0108. It comes from the component's own entry, so the island ships
 * a frame and not the package (cairn 0165).
 */
import { Frame } from '@rockaway/react/frame';
import Document from '../layouts/Document.astro';
---

<Document
  title="rockaway — a TUI design system for the web"
  description="A TUI design system for the web. Everything sits on a character grid: one cell wide, one row tall, no halves."
>
  <main>
    <Frame client:load title="rockaway" rows={5}>
      <p>A TUI design system for the web.</p>
      <p>Nothing is published yet.</p>
      <p><a href="https://github.com/oddurs/rockaway">Source on GitHub</a></p>
    </Frame>
  </main>
</Document>
