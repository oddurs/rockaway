---
/**
 * A foundations page (cairn 0106): MDX set as prose, with its examples drawn
 * by the engine at build time. The pages read in `order`, and each ends with
 * the next, so they can be read through like a chapter.
 */
import { getCollection, render } from 'astro:content';
import Prose from '../../layouts/Prose.astro';
import { href } from '../../lib/paths.ts';

export async function getStaticPaths() {
  const pages = (await getCollection('foundations')).sort((a, b) => a.data.order - b.data.order);
  return pages.map((entry, i) => ({
    params: { page: entry.id },
    props: { entry, next: pages[i + 1] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
---

<Prose title={`${entry.data.title} — rockaway`} description={entry.data.description}>
  <Content />
  <hr />
  <p>
    {
      next ? (
        <>
          Next: <a href={href(`foundations/${next.id}/`)}>{next.data.title}</a>, or back to{' '}
          <a href={href('foundations/')}>the foundations</a>.
        </>
      ) : (
        <>
          Back to <a href={href('foundations/')}>the foundations</a>.
        </>
      )
    }
  </p>
</Prose>
