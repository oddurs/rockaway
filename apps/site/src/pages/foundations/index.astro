---
/**
 * The foundations (cairn 0106): what every component stands on, in the order
 * to read it.
 */
import { getCollection } from 'astro:content';
import Prose from '../../layouts/Prose.astro';
import { fixed } from '../../lib/pages.ts';
import { href } from '../../lib/paths.ts';

const pages = (await getCollection('foundations')).sort((a, b) => a.data.order - b.data.order);
---

<Prose title={fixed.foundations.title} description={fixed.foundations.description}>
  <h1>Foundations</h1>
  <p>
    What every component stands on. Each page is drawn by the system it describes: the frames are
    the engine's, painted by the cell, and the tables are read from the tokens when the site is
    built.
  </p>
  <ol>
    {
      pages.map((p) => (
        <li>
          <a href={href(`foundations/${p.id}/`)}>{p.data.title}</a>. {p.data.description}
        </li>
      ))
    }
  </ol>
</Prose>
