---
/**
 * Every component (cairn 0147), from the metadata: its name and what it is.
 */
import Prose from '../../layouts/Prose.astro';
import { components, inline, slugOf } from '../../lib/components.ts';
import { fixed } from '../../lib/pages.ts';
import { href } from '../../lib/paths.ts';
---

<Prose title={fixed.components.title} description={fixed.components.description}>
  <h1>Components</h1>
  <p>
    Every component in <code>@rockaway/react</code>. Each page is generated from what the component
    says about itself: its snapshots are drawn by its own buffer functions, and its props, states,
    keyboard map and tokens are read from its source.
  </p>
  <ul>
    {
      components.map((c) => (
        <li>
          <a href={href(`components/${slugOf(c.name)}/`)}>
            <code>{c.name}</code>
          </a>
          : <Fragment set:html={inline(c.summary)} />
        </li>
      ))
    }
  </ul>
</Prose>
