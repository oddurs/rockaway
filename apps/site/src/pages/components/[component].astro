---
import { getCollection, render } from 'astro:content';
/**
 * A page per component (cairn 0147), generated from the metadata
 * `@rockaway/react` publishes. Only the live example and its source are
 * written by hand, in `src/content/components/<name>.mdx`; everything else is
 * read from the component's own description of itself, so the page cannot
 * drift from the component. A component with no page, or a page with no
 * component, fails the build.
 *
 * Snapshots are painted as the painter's markup, with no script. When
 * CodeBlock's snapshot (0138) lands, `Painted` becomes it.
 */
import { formatKeys, spokenKeys } from '@rockaway/react';
import type { ComponentMeta } from '@rockaway/react/metadata';
import Painted from '../../components/Painted.astro';
import Table from '../../components/Table.astro';
import Prose from '../../layouts/Prose.astro';
import { componentNamed, components, inline, slugOf, tokenAnchor } from '../../lib/components.ts';
import { escapeHtml } from '../../lib/html.ts';
import { href } from '../../lib/paths.ts';

export async function getStaticPaths() {
  const pages = await getCollection('components');
  const byName = new Map(pages.map((p) => [p.data.name, p]));
  for (const page of pages) {
    if (!componentNamed(page.data.name)) {
      throw new Error(
        `src/content/components/${page.id}.mdx is for ${page.data.name}, which @rockaway/react does not describe`,
      );
    }
  }
  return components.map((meta) => {
    const entry = byName.get(meta.name);
    if (!entry) {
      throw new Error(
        `${meta.name} has no page: add src/content/components/${slugOf(meta.name)}.mdx with its example`,
      );
    }
    return { params: { component: slugOf(meta.name) }, props: { meta, entry } };
  });
}

const { meta, entry } = Astro.props as {
  meta: ComponentMeta;
  entry: Awaited<ReturnType<typeof getCollection<'components'>>>[number];
};
const { Content } = await render(entry);

const link = (name: string) =>
  componentNamed(name)
    ? `<a href="${href(`components/${slugOf(name)}/`)}"><code>${escapeHtml(name)}</code></a>`
    : `<code>${escapeHtml(name)}</code>`;
const imported = meta.anatomy.filter((p) => p.kind === 'import');
const keys = (spec: string) =>
  `<kbd aria-label="${escapeHtml(spokenKeys(spec))}">${escapeHtml(formatKeys(spec))}</kbd>`;
---

<Prose title={`${meta.name} — rockaway`} description={meta.summary.replaceAll('`', '')}>
  <h1>{meta.name}</h1>
  <p set:html={inline(meta.summary)} />

  {
    meta.snapshots.map((snapshot) => (
      <>
        <p>
          <strong>{snapshot.title}.</strong>{' '}
          {snapshot.description && <Fragment set:html={inline(snapshot.description)} />}
        </p>
        <Painted text={snapshot.text} label={`${meta.name}, ${snapshot.title}, as text`} />
      </>
    ))
  }

  <p set:html={inline(meta.description)} />

  <h2>Example</h2>
  <Content />

  <h2>When to use it</h2>
  <ul>{meta.whenToUse.map((use) => <li set:html={inline(use)} />)}</ul>
  <p>And when not to:</p>
  <ul>
    {
      meta.whenNotToUse.map((not) => (
        <li>
          <Fragment set:html={inline(not.text)} />
          {not.instead && (
            <>
              {' '}Use <Fragment set:html={link(not.instead)} /> instead.
            </>
          )}
        </li>
      ))
    }
  </ul>

  <h2>Anatomy</h2>
  <Table
    columns={[{ label: 'Part' }, { label: 'Is' }, { label: 'What it is' }]}
    rows={meta.anatomy.map((part) => [
      { text: part.name, html: `<code>${escapeHtml(part.name)}</code>` },
      part.kind === 'import'
        ? `imported${part.role ? `, role ${part.role}` : ''}`
        : { text: `.${part.className}${part.chrome ? ', chrome' : ''}`, html: `<code>.${escapeHtml(part.className)}</code>${part.chrome ? ', chrome' : ''}` },
      { text: part.description, html: inline(part.description) },
    ])}
  />

  {
    meta.variants.length > 0 && (
      <>
        <h2>Variants</h2>
        {meta.variants.map((variant) => (
          <>
            <p>
              <code>{variant.name}</code>, on <code>{variant.attribute}</code>, defaults to{' '}
              <code>{variant.default}</code>. <Fragment set:html={inline(variant.description)} />
            </p>
            <Table
              columns={[{ label: 'Value', code: true }, { label: 'What it is' }]}
              rows={variant.values.map((v) => [v.value, { text: v.description, html: inline(v.description) }])}
            />
          </>
        ))}
      </>
    )
  }

  {
    meta.states.length > 0 && (
      <>
        <h2>States</h2>
        <p>
          Each is a row of <a href={href('concept/#9-states-are-one-vocabulary')}>the state vocabulary</a>,
          drawn the same way in every component, and none changes a size.
        </p>
        <Table
          columns={[{ label: 'State' }, { label: 'On' }, { label: 'Drawn as' }, { label: 'Without colour' }]}
          rows={meta.states.map((s) => [
            { text: `${s.state} ${s.selectors.join(' ')}`, html: `${escapeHtml(s.state)}, <code>${escapeHtml(s.selectors.join(' '))}</code>` },
            { text: s.part, html: `<code>${escapeHtml(s.part)}</code>` },
            { text: `${s.drawnAs}${s.note ? ` ${s.note}` : ''}`, html: `${inline(s.drawnAs)}${s.note ? `. ${inline(s.note)}` : ''}` },
            s.withoutColour,
          ])}
        />
      </>
    )
  }

  <h2>Props</h2>
  {
    imported.map((part) => (
      <>
        {imported.length > 1 && <h3><code>{part.name}</code></h3>}
        {part.props.length > 0 ? (
          <Table
            columns={[{ label: 'Prop' }, { label: 'Type', code: true }, { label: 'Default', code: true }, { label: 'What it does' }]}
            rows={part.props.map((p) => [
              { text: `${p.name}${p.required ? ' required' : ''}`, html: `<code>${escapeHtml(p.name)}</code>${p.required ? ', required' : ''}` },
              p.type,
              p.default ?? '',
              { text: p.description ?? '', html: inline(p.description ?? '') },
            ])}
          />
        ) : (
          <p>No props of its own.</p>
        )}
        {part.inherits.length > 0 && (
          <p>
            Also takes{' '}
            <Fragment set:html={part.inherits.map((i) => `<code>${escapeHtml(i)}</code>`).join(', ')} />.
          </p>
        )}
      </>
    ))
  }

  <h2>Keyboard and screen readers</h2>
  {
    meta.accessibility.keyboard.length > 0 ? (
      <Table
        columns={[{ label: 'Keys' }, { label: 'Does' }]}
        rows={meta.accessibility.keyboard.map((b) => [
          { text: b.keys.map((k) => formatKeys(k)).join(', '), html: b.keys.map(keys).join(', ') },
          { text: b.action, html: inline(b.action) },
        ])}
      />
    ) : (
      <p>Nothing of its own to press: it is not a control.</p>
    )
  }
  <p><strong>Its name.</strong> <Fragment set:html={inline(meta.accessibility.name)} /></p>
  <p><strong>What a reader hears.</strong> <Fragment set:html={inline(meta.accessibility.announces)} /></p>
  {
    meta.accessibility.notes.length > 0 && (
      <ul>{meta.accessibility.notes.map((n) => <li set:html={inline(n)} />)}</ul>
    )
  }

  <h2>Tokens</h2>
  <p>
    What its stylesheet and its painter read, each linked to <a href={href('foundations/tokens/')}>the token reference</a>:
  </p>
  <ul>
    {
      meta.tokens.map((token) => (
        <li>
          <a href={href(`foundations/tokens/#${tokenAnchor(token)}`)}><code>{token}</code></a>
        </li>
      ))
    }
  </ul>

  {
    meta.related.length > 0 && (
      <>
        <h2>Related</h2>
        <ul>
          {meta.related.map((r) => (
            <li>
              <Fragment set:html={link(r.name)} />: <Fragment set:html={inline(r.why)} />
            </li>
          ))}
        </ul>
      </>
    )
  }
</Prose>
