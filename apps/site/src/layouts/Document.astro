---
import catppuccin from '@rockaway/tokens/themes/catppuccin.css?url';
import dracula from '@rockaway/tokens/themes/dracula.css?url';
import ice from '@rockaway/tokens/themes/ice.css?url';
import ink from '@rockaway/tokens/themes/ink.css?url';
import nord from '@rockaway/tokens/themes/nord.css?url';
import phosphor from '@rockaway/tokens/themes/phosphor.css?url';
import solarized from '@rockaway/tokens/themes/solarized.css?url';
import tokyoNight from '@rockaway/tokens/themes/tokyo-night.css?url';
/**
 * The document every page is rendered into (cairn 0103). It owns `<html>` and
 * the order of the head, which matters on a grid:
 *
 *   1. charset and viewport
 *   2. the pre-paint script that applies theme, mode and density (0148), so
 *      the first frame is already the reader's choice
 *   3. the font, preloaded, and its faces, so the cell is the right width from
 *      the first frame whether or not the font has arrived
 *   4. the system's stylesheet, which the build appends
 *
 * The page's one script is an enhancement: where the browser has no
 * scroll-state queries, it shows the overflow marks on code and tables that
 * scroll across (0218). With it off, they scroll without marks.
 *
 * Keep logic out of here: frontmatter in an `.astro` file is not typechecked
 * (see the site's README), so it lives in `src/lib`.
 */
import fontUrl from '../fonts/jetbrains-mono.woff2?url';
import { fontFaces } from '../lib/font.ts';
import { prePaint } from '../lib/look.ts';
import { cardPath } from '../lib/pages.ts';
import { href } from '../lib/paths.ts';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Where the page is, for the canonical link and its card (0150). The card is
// named by the page's path under the base.
const site = Astro.site ?? new URL('https://oddurs.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const under = Astro.url.pathname.slice(import.meta.env.BASE_URL.length);
const card = new URL(href(cardPath(under)), site).href;
// Every theme but the default is a stylesheet of its own, loaded only when
// it is the reader's choice (0148).
const themes = {
  catppuccin,
  dracula,
  ice,
  ink,
  nord,
  phosphor,
  solarized,
  'tokyo-night': tokyoNight,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Before anything is drawn: script runs, so the shell will lay itself out
      (0104) and stays hidden until it has; and the reader's look (0148) is
      on <html>, its theme's stylesheet blocking the first frame.
    -->
    <script is:inline set:html={prePaint(themes)}></script>
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces(fontUrl)}></style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('favicon.png')} type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href={href('favicon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="rockaway" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}: the page's title in a frame, drawn on the character grid.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={card} />
  </head>
  <body>
    <slot />
    <script>
      import { watchOverflowMarks } from '@rockaway/react';
      watchOverflowMarks();
    </script>
  </body>
</html>
