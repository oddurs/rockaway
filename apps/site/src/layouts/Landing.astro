---
/**
 * The landing page's layout (cairn 0108): the same system as the docs, laid
 * out as a product page rather than an app. A top bar, the page in one column
 * of whole cells, and a footer. The docs are software you use (Prose.astro,
 * in the shell); this is the page that says what the software is. The
 * contrast is the argument: one grid, one set of tokens, two compositions.
 */
import { TopBar } from '../components/TopBar.tsx';
import { href } from '../lib/paths.ts';
import Document from './Document.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Document title={title} description={description}>
  <a class="site-skip" href="#content">Skip to the page</a>
  <div class="site-landing">
    <TopBar home={href('')} docs={href('getting-started/')} components={href('components/')} />
    <main id="content" tabindex="-1" class="rk-prose site-landing-page">
      <slot />
    </main>
    <footer class="rk-prose site-footer">
      <hr />
      <nav aria-label="Everything else" class="site-footer-links">
        <a href={href('getting-started/')}>Getting started</a>
        <a href={href('concept/')}>The concept</a>
        <a href={href('foundations/')}>Foundations</a>
        <a href={href('components/')}>Components</a>
        <a href="https://github.com/oddurs/rockaway">GitHub</a>
      </nav>
      <p>MIT licensed. Set in JetBrains Mono, under the SIL Open Font License.</p>
    </footer>
  </div>
</Document>

<script>
  import '../scripts/landing.ts';
</script>
