---
/**
 * A table the site writes from data (cairn 0106), set by `.rk-prose` like a
 * Markdown table, with its columns sized in whole cells the same way the
 * Markdown pipeline sizes them. A cell is text, or code when its column says.
 * A cell may also carry a swatch: a run of block cells in a token's colour,
 * drawn by the cell like any other block.
 */
import { shapeOf } from '@rockaway/grid';
import { escapeHtml } from '../lib/html.ts';
import { columnCells } from '../lib/markdown.ts';

export interface Column {
  readonly label: string;
  readonly code?: boolean;
  readonly align?: 'right';
}

export interface Cell {
  /** As text; also what the column is sized by. */
  readonly text: string;
  /** Markup to show instead, when the text needs a link or code in it. */
  readonly html?: string;
  /** A custom property to draw a swatch in, before the text: `--rk-ansi-red`. */
  readonly swatch?: string;
}

interface Props {
  columns: readonly Column[];
  rows: readonly (readonly (string | Cell)[])[];
  /** An id for each row, for a link to it. */
  ids?: readonly string[];
  caption?: string;
}

const { columns, rows, ids, caption } = Astro.props;

/** Text, with anything the cell draws (a `─`, a `█`) as a cell of its own, as in prose. */
const shaped = (text: string): string =>
  [...text]
    .map((ch) => {
      const shape = shapeOf(ch);
      return shape ? `<span data-rk-shape="${shape.key}">${escapeHtml(ch)}</span>` : escapeHtml(ch);
    })
    .join('');
const cellOf = (c: string | Cell): Cell => (typeof c === 'string' ? { text: c } : c);
const SWATCH = 4;
const widths = columnCells([
  columns.map((c) => c.label),
  ...rows.map((row) =>
    row.map((c) => {
      const cell = cellOf(c);
      return cell.swatch ? `${'█'.repeat(SWATCH)} ${cell.text}` : cell.text;
    }),
  ),
]);
---

<table tabindex="0">
  {caption && <caption>{caption}</caption>}
  {widths && <colgroup>{widths.map((w) => <col style={`--rk-cols: ${w}`} />)}</colgroup>}
  <thead>
    <tr>{columns.map((c) => <th scope="col" align={c.align}>{c.label}</th>)}</tr>
  </thead>
  <tbody>
    {
      rows.map((row, r) => (
        <tr id={ids?.[r]}>
          {row.map((raw, i) => {
            const cell = cellOf(raw);
            const column = columns[i];
            return (
              <td align={column?.align}>
                {cell.swatch && (
                  <span data-rk-painted="glyph" aria-hidden="true"><span class="rk-run" data-rk-shape="block-2588" style={`--rk-run: ${SWATCH}; color: var(${cell.swatch})`}>{'█'.repeat(SWATCH)}</span> </span>
                )}
                {cell.html !== undefined ? (
                  <Fragment set:html={cell.html} />
                ) : column?.code ? (
                  <code>{cell.text}</code>
                ) : (
                  <Fragment set:html={shaped(cell.text)} />
                )}
              </td>
            );
          })}
        </tr>
      ))
    }
  </tbody>
</table>
