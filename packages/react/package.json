{
  "name": "@rockaway/react",
  "version": "0.0.0",
  "description": "React primitives for rockaway, built on React Aria Components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rockaway/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./paint": {
      "@rockaway/source": "./src/paint/index.ts",
      "default": "./dist/paint.js"
    },
    "./testing": {
      "@rockaway/source": "./src/testing/screenshot.ts",
      "default": "./dist/screenshot.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@rockaway/css": "workspace:^",
    "@rockaway/grid": "workspace:^",
    "react-aria-components": "1.21.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/rockaway.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/oddurs/rockaway",
  "publishConfig": {
    "access": "public"
  }
}
