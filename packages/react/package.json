{
  "name": "@rockaway/react",
  "version": "0.0.0",
  "description": "React primitives for rockaway, built on React Aria Components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rockaway/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paint": {
      "@rockaway/source": "./src/paint/index.ts",
      "types": "./dist/paint/index.d.ts",
      "default": "./dist/paint/index.js"
    },
    "./dom": {
      "@rockaway/source": "./src/dom.ts",
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./testing": {
      "@rockaway/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./metadata": {
      "@rockaway/source": "./src/metadata/index.ts",
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./meta.json": "./dist/meta.json",
    "./meta.schema.json": "./dist/meta.schema.json",
    "./*": {
      "@rockaway/source": "./src/entries/*.ts",
      "types": "./dist/entries/*.d.ts",
      "default": "./dist/entries/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/meta-json.ts",
    "metadata": "node scripts/metadata.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:server": "node --conditions=react-server test/server-component/render.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@rockaway/css": "workspace:^",
    "@rockaway/grid": "workspace:^",
    "@rockaway/tokens": "workspace:^",
    "react-aria-components": "1.21.1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "oxc-parser": "0.127.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/rockaway.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/oddurs/rockaway",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./paint": {
        "types": "./dist/paint/index.d.ts",
        "default": "./dist/paint/index.js"
      },
      "./dom": {
        "types": "./dist/dom/index.d.ts",
        "default": "./dist/dom/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./metadata": {
        "types": "./dist/metadata/index.d.ts",
        "default": "./dist/metadata/index.js"
      },
      "./meta.json": "./dist/meta.json",
      "./meta.schema.json": "./dist/meta.schema.json",
      "./*": {
        "types": "./dist/entries/*.d.ts",
        "default": "./dist/entries/*.js"
      },
      "./package.json": "./package.json"
    }
  }
}
