{
  "name": "@rockaway/css",
  "version": "0.0.0",
  "description": "The CSS contract for rockaway: cascade layers, reset, base and component styles.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "node --conditions=@rockaway/source scripts/shapes.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/rockaway.git",
    "directory": "packages/css"
  },
  "homepage": "https://github.com/oddurs/rockaway",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rockaway/grid": "workspace:*",
    "@types/node": "26.6.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
