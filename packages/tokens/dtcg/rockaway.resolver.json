{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "name": "rockaway",
  "description": "Theme tokens generated from every shipped theme. Theme, mode and density are runtime contexts (cairn 0058, 0052).",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "base.tokens.json"
        },
        {
          "$ref": "semantic.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "The theme: a palette in both modes, its type and its glyphs. Overrides palette.*, font.* and glyph.* only.",
      "contexts": {
        "default": [
          {
            "$ref": "theme.default.tokens.json"
          }
        ],
        "ice": [
          {
            "$ref": "theme.ice.tokens.json"
          }
        ],
        "ink": [
          {
            "$ref": "theme.ink.tokens.json"
          }
        ],
        "phosphor": [
          {
            "$ref": "theme.phosphor.tokens.json"
          }
        ],
        "ascii": [
          {
            "$ref": "theme.ascii.tokens.json"
          }
        ],
        "sunset": [
          {
            "$ref": "theme.sunset.tokens.json"
          }
        ],
        "catppuccin": [
          {
            "$ref": "theme.catppuccin.tokens.json"
          }
        ],
        "dracula": [
          {
            "$ref": "theme.dracula.tokens.json"
          }
        ],
        "nord": [
          {
            "$ref": "theme.nord.tokens.json"
          }
        ],
        "solarized": [
          {
            "$ref": "theme.solarized.tokens.json"
          }
        ],
        "tokyo-night": [
          {
            "$ref": "theme.tokyo-night.tokens.json"
          }
        ]
      },
      "default": "default"
    },
    "mode": {
      "description": "Colour mode. Points ansi.* at one half of the theme palette, and nothing else.",
      "contexts": {
        "light": [
          {
            "$ref": "mode.light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "mode.dark.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "contrast": {
      "description": "Contrast (cairn 0065): `more` is what prefers-contrast: more asks for. Re-reads the semantic tier from the same palette, and thickens lines and the focus ring.",
      "contexts": {
        "standard": [
          {
            "$ref": "contrast.standard.tokens.json"
          }
        ],
        "more": [
          {
            "$ref": "contrast.more.tokens.json"
          }
        ]
      },
      "default": "standard"
    },
    "density": {
      "description": "Density: the line box. Overrides cell.*, space.*, row.* and size.* only.",
      "contexts": {
        "dense": [
          {
            "$ref": "density.dense.tokens.json"
          }
        ],
        "normal": [
          {
            "$ref": "density.normal.tokens.json"
          }
        ],
        "airy": [
          {
            "$ref": "density.airy.tokens.json"
          }
        ],
        "touch": [
          {
            "$ref": "density.touch.tokens.json"
          }
        ]
      },
      "default": "normal"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/modifiers/mode"
    },
    {
      "$ref": "#/modifiers/contrast"
    },
    {
      "$ref": "#/modifiers/density"
    }
  ]
}
