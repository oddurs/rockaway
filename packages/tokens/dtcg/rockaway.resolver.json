{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "name": "rockaway",
  "description": "Theme tokens generated from the theme inputs. Mode and density are runtime contexts (cairn 0058).",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "base.tokens.json"
        },
        {
          "$ref": "semantic.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "mode": {
      "description": "Colour mode. Overrides ansi.* only.",
      "contexts": {
        "light": [
          {
            "$ref": "palette.light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "palette.dark.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "density": {
      "description": "Density: the line box. Overrides cell.*, space.*, row.* and size.* only.",
      "contexts": {
        "dense": [
          {
            "$ref": "density.dense.tokens.json"
          }
        ],
        "normal": [
          {
            "$ref": "density.normal.tokens.json"
          }
        ],
        "airy": [
          {
            "$ref": "density.airy.tokens.json"
          }
        ],
        "touch": [
          {
            "$ref": "density.touch.tokens.json"
          }
        ]
      },
      "default": "normal"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/mode"
    },
    {
      "$ref": "#/modifiers/density"
    }
  ]
}
