      }
    },
    "success": {
      "solid": {
        "$type": "color",
        "$value": "{ansi.foreground}"
      },
      "solid-hover": {
        "$type": "color",
        "$value": "{ansi.foreground}"
      }
    },
    "warning": {
      "solid": {
        "$type": "color",
        "$value": "{ansi.foreground}"
      },
      "solid-hover": {
        "$type": "color",
        "$value": "{ansi.foreground}"
