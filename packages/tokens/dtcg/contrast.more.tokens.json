        "$type": "color",
        "$value": "{ansi.foreground}"
      },
      "solid-hover": {
        "$type": "color",
        "$value": "{ansi.foreground}"
      }
    }
  },
  "border": {
    "subtle": {
      "$type": "color",
      "$value": "{ansi.border}"
    },
    "default": {
      "$type": "color",
      "$value": "{ansi.border-strong}"
    },
    "surface": {
      "$type": "color",
      "$value": "{ansi.border-strong}"
    },
    "control": {
      "$type": "color",
      "$value": "{ansi.foreground}"
    }
  },
  "syntax": {
    "comment": {
      "$type": "color",
      "$value": "{ansi.foreground}"
    },
    "keyword": {
      "$type": "color",
      "$value": "{ansi.bright-magenta}"
    },
    "string": {
      "$type": "color",
      "$value": "{ansi.bright-green}"
    },
    "constant": {
      "$type": "color",
      "$value": "{ansi.bright-yellow}"
    },
    "function": {
      "$type": "color",
      "$value": "{ansi.bright-blue}"
    },
