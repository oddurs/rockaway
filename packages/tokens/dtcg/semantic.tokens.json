{
  "bg": {
    "$type": "color",
    "$description": "Backgrounds. Components read these, never palette slots.",
    "page": {
      "$value": "{ansi.background}",
      "$description": "The page behind everything: the terminal background."
    },
    "surface": {
      "$value": "{ansi.surface}",
      "$description": "A raised surface. On a grid it is its border that raises it."
    },
    "subtle": {
      "$value": "{ansi.subtle}",
      "$description": "Quiet element backgrounds: inputs, wells, code."
    },
    "hover": {
      "$value": "{ansi.hover}",
      "$description": "An element under the pointer."
    },
    "active": {
      "$value": "{ansi.active}",
      "$description": "An element being pressed, or selected."
    },
    "inverse": {
      "$value": "{ansi.foreground}",
      "$description": "Reverse video: the foreground becomes the ground."
    },
    "accent": {
      "solid": {
        "$value": "{ansi.blue}",
        "$description": "Filled accent backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-blue}"
      },
      "subtle": {
        "$value": "{ansi.tint-blue}",
        "$description": "Tinted accent backgrounds: callouts, rows."
      }
    },
    "info": {
      "solid": {
        "$value": "{ansi.cyan}",
        "$description": "Filled info backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-cyan}"
      },
      "subtle": {
        "$value": "{ansi.tint-cyan}",
        "$description": "Tinted info backgrounds: callouts, rows."
      }
    },
    "success": {
      "solid": {
        "$value": "{ansi.green}",
        "$description": "Filled success backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-green}"
      },
      "subtle": {
        "$value": "{ansi.tint-green}",
        "$description": "Tinted success backgrounds: callouts, rows."
      }
    },
    "warning": {
      "solid": {
        "$value": "{ansi.yellow}",
        "$description": "Filled warning backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-yellow}"
      },
      "subtle": {
        "$value": "{ansi.tint-yellow}",
        "$description": "Tinted warning backgrounds: callouts, rows."
      }
    },
    "danger": {
      "solid": {
        "$value": "{ansi.red}",
        "$description": "Filled danger backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-red}"
      },
      "subtle": {
        "$value": "{ansi.tint-red}",
        "$description": "Tinted danger backgrounds: callouts, rows."
      }
    }
  },
  "fg": {
    "$type": "color",
    "$description": "Text and glyphs.",
    "default": {
      "$value": "{ansi.foreground}",
      "$description": "Body text. At least 7:1 on every background."
    },
    "muted": {
      "$value": "{ansi.muted}",
      "$description": "Secondary text. At least 4.5:1 on every background."
    },
    "disabled": {
      "$value": "{ansi.faint}",
      "$description": "Disabled text. Exempt from contrast minimums, so never load-bearing."
    },
    "on-inverse": {
      "$value": "{ansi.background}"
    },
    "accent": {
      "$value": "{ansi.blue}",
      "$description": "Links and accent text."
    },
    "info": {
      "$value": "{ansi.cyan}"
    },
    "success": {
      "$value": "{ansi.green}"
    },
    "warning": {
      "$value": "{ansi.yellow}"
    },
    "danger": {
      "$value": "{ansi.red}"
    },
    "on-accent": {
      "$value": "{ansi.background}",
      "$description": "Text on bg.accent.solid."
    },
    "on-info": {
      "$value": "{ansi.background}"
    },
    "on-success": {
      "$value": "{ansi.background}"
    },
    "on-warning": {
      "$value": "{ansi.background}"
    },
    "on-danger": {
      "$value": "{ansi.background}"
    }
  },
  "border": {
    "$type": "color",
    "$description": "Borders and rules, whether drawn as glyphs or as hairlines.",
    "subtle": {
      "$value": "{ansi.border-subtle}",
      "$description": "Decorative separation only, below 3:1: a rule inside a surface that something else already bounds. Never the only edge of anything (cairn 0178)."
    },
    "default": {
      "$value": "{ansi.border}",
      "$description": "The ordinary edge: frames, dividers, tables. A boundary a reader can see, at least 3:1 against every ground it is drawn on (WCAG 1.4.11, cairn 0178)."
    },
    "control": {
      "$value": "{ansi.border-strong}",
      "$description": "The boundary of an input or control. At least 3:1 (WCAG 1.4.11)."
    },
    "surface": {
      "$value": "{ansi.border}",
      "$description": "The edge of a resting surface. On a grid, a surface is its border, so it is border.default."
    },
    "focus": {
      "$value": "{ansi.blue}",
      "$description": "The focus ring, and the cursor (0061)."
    },
    "accent": {
      "$value": "{ansi.blue}"
    },
    "info": {
      "$value": "{ansi.cyan}"
    },
    "success": {
      "$value": "{ansi.green}"
    },
    "warning": {
      "$value": "{ansi.yellow}"
    },
    "danger": {
      "$value": "{ansi.red}"
    }
  },
  "syntax": {
    "$type": "color",
    "$description": "Code, highlighted in the ANSI 16 the way terminal editors do it (0144). Each role is a palette slot, so code follows the theme and the mode, and a terminal theme a reader imports recolours it.",
    "plain": {
      "$value": "{ansi.foreground}",
      "$description": "Identifiers, punctuation, anything unnamed."
    },
    "comment": {
      "$value": "{ansi.muted}",
      "$description": "Comments. Also italic, so they read as comments in greyscale."
    },
    "keyword": {
      "$value": "{ansi.magenta}",
      "$description": "Keywords and storage: `import`, `const`."
    },
    "string": {
      "$value": "{ansi.green}",
      "$description": "Strings and template literals."
    },
    "constant": {
      "$value": "{ansi.yellow}",
      "$description": "Numbers, booleans, constants."
    },
    "function": {
      "$value": "{ansi.blue}",
      "$description": "Function and method names."
    },
    "type": {
      "$value": "{ansi.cyan}",
      "$description": "Types, classes, components, tag names."
    },
    "attribute": {
      "$value": "{ansi.yellow}",
      "$description": "Attribute and property keys in markup."
    },
    "regexp": {
      "$value": "{ansi.red}",
      "$description": "Regular expressions and escapes."
    },
    "inserted": {
      "$value": "{ansi.green}",
      "$description": "Added lines in a diff."
    },
    "deleted": {
      "$value": "{ansi.red}",
      "$description": "Removed lines in a diff."
    },
    "error": {
      "$value": "{ansi.red}",
      "$description": "Invalid code. Also underlined, so it reads as an error in greyscale."
    }
  },
  "motion": {
    "tick": {
      "$type": "duration",
      "$description": "Frames on a tick (cairn 0120): how long each frame of a stepped animation holds. Under reduced motion the frames stop and the first frame stays.",
      "spinner": {
        "$value": {
          "value": 80,
          "unit": "ms"
        }
      },
      "blink": {
        "$value": {
          "value": 500,
          "unit": "ms"
        }
      },
      "progress": {
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      }
    }
  },
  "focus": {
    "$type": "dimension",
    "$description": "The focus ring (0061): a gap in the surface colour, then the ring in border.focus.",
    "width": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "offset": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  }
}
