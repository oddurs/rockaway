{
  "bg": {
    "$type": "color",
    "$description": "Backgrounds. Components read these, never palette slots.",
    "page": {
      "$value": "{ansi.background}",
      "$description": "The page behind everything: the terminal background."
    },
    "surface": {
      "$value": "{ansi.surface}",
      "$description": "A raised surface. On a grid it is its border that raises it."
    },
    "subtle": {
      "$value": "{ansi.subtle}",
      "$description": "Quiet element backgrounds: inputs, wells, code."
    },
    "hover": {
      "$value": "{ansi.hover}",
      "$description": "An element under the pointer."
    },
    "active": {
      "$value": "{ansi.active}",
      "$description": "An element being pressed, or selected."
    },
    "inverse": {
      "$value": "{ansi.foreground}",
      "$description": "Reverse video: the foreground becomes the ground."
    },
    "accent": {
      "solid": {
        "$value": "{ansi.blue}",
        "$description": "Filled accent backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-blue}"
      },
      "subtle": {
        "$value": "{ansi.tint-blue}",
        "$description": "Tinted accent backgrounds: callouts, rows."
      }
    },
    "info": {
      "solid": {
        "$value": "{ansi.cyan}",
        "$description": "Filled info backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-cyan}"
      },
      "subtle": {
        "$value": "{ansi.tint-cyan}",
        "$description": "Tinted info backgrounds: callouts, rows."
      }
    },
    "success": {
      "solid": {
        "$value": "{ansi.green}",
        "$description": "Filled success backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-green}"
      },
      "subtle": {
        "$value": "{ansi.tint-green}",
        "$description": "Tinted success backgrounds: callouts, rows."
      }
    },
    "warning": {
      "solid": {
        "$value": "{ansi.yellow}",
        "$description": "Filled warning backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-yellow}"
      },
      "subtle": {
        "$value": "{ansi.tint-yellow}",
        "$description": "Tinted warning backgrounds: callouts, rows."
      }
    },
    "danger": {
      "solid": {
        "$value": "{ansi.red}",
        "$description": "Filled danger backgrounds."
      },
      "solid-hover": {
        "$value": "{ansi.bright-red}"
      },
      "subtle": {
        "$value": "{ansi.tint-red}",
        "$description": "Tinted danger backgrounds: callouts, rows."
      }
    }
  },
  "fg": {
    "$type": "color",
    "$description": "Text and glyphs.",
    "default": {
      "$value": "{ansi.foreground}",
      "$description": "Body text. At least 7:1 on every background."
    },
    "muted": {
      "$value": "{ansi.muted}",
      "$description": "Secondary text. At least 4.5:1 on every background."
    },
    "disabled": {
      "$value": "{ansi.faint}",
      "$description": "Disabled text. Exempt from contrast minimums, so never load-bearing."
    },
    "on-inverse": {
      "$value": "{ansi.background}"
    },
    "accent": {
      "$value": "{ansi.blue}",
      "$description": "Links and accent text."
    },
    "info": {
      "$value": "{ansi.cyan}"
    },
    "success": {
      "$value": "{ansi.green}"
    },
    "warning": {
      "$value": "{ansi.yellow}"
    },
    "danger": {
      "$value": "{ansi.red}"
    },
    "on-accent": {
      "$value": "{ansi.background}",
      "$description": "Text on bg.accent.solid."
    },
    "on-info": {
      "$value": "{ansi.background}"
    },
    "on-success": {
      "$value": "{ansi.background}"
    },
    "on-warning": {
      "$value": "{ansi.background}"
    },
    "on-danger": {
      "$value": "{ansi.background}"
    }
  },
  "border": {
    "$type": "color",
    "$description": "Borders and rules, whether drawn as glyphs or as hairlines.",
    "subtle": {
      "$value": "{ansi.border-subtle}",
      "$description": "Separators inside a surface."
    },
    "default": {
      "$value": "{ansi.border}",
      "$description": "The ordinary edge: frames, dividers, tables."
    },
    "control": {
      "$value": "{ansi.border-strong}",
      "$description": "The boundary of an input or control. At least 3:1 (WCAG 1.4.11)."
    },
    "surface": {
      "$value": "{ansi.border}",
      "$description": "The edge of a resting surface. On a grid, a surface is its border."
    },
    "focus": {
      "$value": "{ansi.blue}",
      "$description": "The focus ring, and the cursor (0061)."
    },
    "accent": {
      "$value": "{ansi.blue}"
    },
    "info": {
      "$value": "{ansi.cyan}"
    },
    "success": {
      "$value": "{ansi.green}"
    },
    "warning": {
      "$value": "{ansi.yellow}"
    },
    "danger": {
      "$value": "{ansi.red}"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "enter": {
        "$value": [
          0,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$value": [
          0.3,
          0,
          1,
          1
        ]
      }
    }
  },
  "focus": {
    "$type": "dimension",
    "$description": "The focus ring (0061): a gap in the surface colour, then the ring in border.focus.",
    "width": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "offset": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  }
}
