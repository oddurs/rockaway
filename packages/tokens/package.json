{
  "name": "@rockaway/tokens",
  "version": "0.0.0",
  "description": "Design tokens for rockaway: DTCG sources, the resolver, and CSS custom properties.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@rockaway/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./dtcg/*": "./dtcg/*",
    "./themes/*": "./themes/*",
    "./package.json": "./package.json",
    "./tailwind.css": "./css/tailwind.css",
    "./terminal/*": "./terminal/*"
  },
  "files": [
    "css",
    "dist",
    "dtcg",
    "terminal",
    "themes"
  ],
  "scripts": {
    "build": "tsdown",
    "generate": "node scripts/generate.ts && tz build && node scripts/fix-properties.ts && node scripts/terminal.ts",
    "generate:check": "node scripts/generate.ts --check && node scripts/check-css.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "contrast": "node scripts/contrast.ts",
    "terminal": "node scripts/terminal.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/rockaway.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/oddurs/rockaway",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rockaway/grid": "workspace:*",
    "@terrazzo/cli": "2.7.1",
    "@terrazzo/parser": "2.7.1",
    "@terrazzo/plugin-css": "2.7.1",
    "@types/node": "26.6.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
