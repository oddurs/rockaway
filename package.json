{
  "name": "rockaway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "baseline 2024"
  ],
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter workbench dev",
    "roadmap:check": "cairn check && cairn render --check",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm roadmap:check",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
